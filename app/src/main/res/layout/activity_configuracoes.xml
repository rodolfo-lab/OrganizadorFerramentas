<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/telaConfiguracoes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSecaoLista"
            style="@style/EstiloTituloSecao"
            android:text="@string/config_secao_lista" />

        <TextView
            android:id="@+id/tvLabelOrdenacao"
            style="@style/EstiloRotulo"
            android:text="@string/config_ordenacao" />

        <RadioGroup
            android:id="@+id/ordenacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbOrdenacaoCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ordenacao_cadastro" />

            <RadioButton
                android:id="@+id/rbOrdenacaoNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ordenacao_nome" />

            <RadioButton
                android:id="@+id/rbOrdenacaoCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ordenacao_codigo" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tvSecaoCadastro"
            style="@style/EstiloTituloSecao"
            android:layout_marginTop="24dp"
            android:text="@string/config_secao_cadastro" />

        <CheckBox
            android:id="@+id/sugestoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/config_sugestoes" />

        <TextView
            android:id="@+id/tvAjudaSugestoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/config_sugestoes_ajuda"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLabelLocalizacaoPadrao"
            style="@style/EstiloRotulo"
            android:text="@string/config_localizacao_padrao" />

        <EditText
            android:id="@+id/textLocalizacaoPadrao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/localizacao_dica"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvLabelCategoriaPadrao"
            style="@style/EstiloRotulo"
            android:text="@string/config_categoria_padrao" />

        <Spinner
            android:id="@+id/categoriaPadrao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/categorias_ferramentas" />

        <CheckBox
            android:id="@+id/disponivelPadrao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/config_disponivel_padrao" />

    </LinearLayout>

</ScrollView>
