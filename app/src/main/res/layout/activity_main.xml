<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/titulo"
            android:textColor="@color/primary_variant"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLabelNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nome"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/nome_dica"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvLabelCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/codigo"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/codigo_dica"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvLabelLocalizacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/localizacao"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textLocalizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/localizacao_dica"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvLabelCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/categoria"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/categorias_ferramentas" />

        <TextView
            android:id="@+id/tvLabelEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/estado"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbNova"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_nova" />

            <RadioButton
                android:id="@+id/rbUsadaBoa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_usada_boa" />

            <RadioButton
                android:id="@+id/rbUsadaReparo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_usada_reparo" />

            <RadioButton
                android:id="@+id/rbDanificada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_danificada" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/disponivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/disponivel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnLimpar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/limpar" />

            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/salvar" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>